{
  "name": "diamond-attendance-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "description": "Web Diamond rank assessment - React Native, Expo and navigation",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "check": "node checks/check.mjs",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.3.0",
    "expo": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "^57.0.12",
    "eslint": "^10.11.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/checks/**/*.check.[jt]s?(x)"
    ],
    "reporters": [
      "<rootDir>/checks/step-reporter.cjs"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/checks/setup.ts"
    ],
    "moduleNameMapper": {
      "\\.(css)$": "<rootDir>/checks/styleStub.js"
    },
    "testTimeout": 20000
  }
}
